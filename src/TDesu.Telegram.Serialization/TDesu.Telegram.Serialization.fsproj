<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <RootNamespace>TDesu.Serialization</RootNamespace>
        <Authors>TDesu</Authors>
        <Description>TL (Type Language) binary serialization for Telegram MTProto: pooled buffers, computation expression builder, typed parsers, generated types.</Description>
        <PackageTags>fsharp;telegram;mtproto;tl;serialization</PackageTags>
        <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/techiedesu/TDesu.Telegram.Serialization</PackageProjectUrl>
        <RepositoryUrl>https://github.com/techiedesu/TDesu.Telegram.Serialization</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>embedded</DebugType>
        <MinVerTagPrefix>v</MinVerTagPrefix>
    </PropertyGroup>
    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="TlWriteBuffer.fs" />
        <Compile Include="TlBuilder.fs" />
        <Compile Include="TlReadBuffer.fs" />
        <Compile Include="GeneratedCid.g.fs" />
        <Compile Include="GeneratedLayerAliases.g.fs" />
        <Compile Include="TlSharedTypes.fs" />
        <Compile Include="GeneratedTlTypes.g.fs" />
        <Compile Include="GeneratedTlRequests.g.fs" />
        <Compile Include="GeneratedTlWriters.g.fs" />
        <Compile Include="TlWriters.fs" />
        <Compile Include="GeneratedCoverageValidator.g.fs" />
        <Compile Include="GeneratedReturnTypes.g.fs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="TDesu.FSharp" />
        <PackageReference Include="MinVer" PrivateAssets="all" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    </ItemGroup>
</Project>
